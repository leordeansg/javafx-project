<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<VBox id="vbox" fx:id="vbox" prefHeight="800.0" prefWidth="1200.0" spacing="15" stylesheets="@../styles/style.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.ServiceController">
   <children>
      <HBox id="hbox" fx:id="hbox" styleClass="hbox" stylesheets="@../styles/style.css">
         <children>
            <Label id="textcolor" fx:id="title" prefHeight="50.0" prefWidth="329.0" styleClass="title" stylesheets="@../styles/style.css" text="GGM @Service History">
               <font>
                  <Font name="System Bold Italic" size="30.0" />
               </font>
               <padding>
                  <Insets left="5.0" top="5.0" />
               </padding>
            </Label>
            <Pane id="dragpane" fx:id="dragpane" onMouseDragged="#drag" onMousePressed="#press" prefHeight="50.0" prefWidth="831.0" stylesheets="@../styles/style.css" HBox.hgrow="ALWAYS" />
            <Button id="minbutton" fx:id="minbutton" alignment="CENTER_RIGHT" onAction="#min" prefHeight="25.0" prefWidth="21.0" stylesheets="@../styles/style.css" text="—">
               <font>
                  <Font name="System Bold" size="12.0" />
               </font>
               <HBox.margin>
                  <Insets right="-1.0" />
               </HBox.margin>
            </Button>
            <Button id="closebutton" fx:id="closebutton" alignment="CENTER_RIGHT" onAction="#close" prefHeight="25.0" prefWidth="17.0" stylesheets="@../styles/style.css" text="X">
               <font>
                  <Font name="System Bold" size="12.0" />
               </font>
               <HBox.margin>
                  <Insets right="2.0" />
               </HBox.margin>
            </Button>
         </children>
      </HBox>
      <Text id="linecolor" fill="WHITE" strokeType="OUTSIDE" strokeWidth="0.0" text="────────────────────────────────────────────────────────────────────────────────────────────────────" textAlignment="CENTER" wrappingWidth="1200.18359375">
         <VBox.margin>
            <Insets top="-15.0" />
         </VBox.margin>
      </Text>
      <Pane prefHeight="644.0" prefWidth="1201.0">
         <children>
            <Pane id="pane" layoutX="386.0" layoutY="-3.0" prefHeight="644.0" prefWidth="801.0">
               <children>
                  <TableView id="tableview" fx:id="serviceTable" editable="true" layoutX="10.0" layoutY="12.0" prefHeight="620.0" prefWidth="781.0">
                     <columns>
                        <TableColumn id="tableview" fx:id="serviceTableDate" minWidth="0.0" prefWidth="180.0" text="Date" />
                        <TableColumn id="tableview" fx:id="serviceTableMiles" minWidth="0.0" prefWidth="180.0" text="Miles" />
                        <TableColumn id="tableview" fx:id="serviceTableNote" minWidth="0.0" prefWidth="417.0" text="Note" />
                     </columns>
                  </TableView>
               </children></Pane>
            <Pane id="pane" layoutX="14.0" layoutY="-3.0" prefHeight="644.0" prefWidth="363.0">
               <children>
                  <Pane id="pane2" layoutX="14.0" layoutY="12.0" prefHeight="620.0" prefWidth="336.0">
                     <children>
                        <Button id="button" fx:id="serviceAddEntry" layoutX="4.0" layoutY="563.0" mnemonicParsing="false" onAction="#serviceAdd" prefHeight="50.0" prefWidth="161.0" text="Add Service">
                           <font>
                              <Font name="System Bold" size="12.0" />
                           </font>
                        </Button>
                        <Button id="button" fx:id="serviceDeleteEntry" layoutX="172.0" layoutY="563.0" mnemonicParsing="false" onAction="#serviceDelete" prefHeight="50.0" prefWidth="161.0" text="Delete Service">
                           <font>
                              <Font name="System Bold" size="12.0" />
                           </font>
                        </Button>
                        <Label id="textcolor" fx:id="serviceError" alignment="CENTER" layoutX="1.0" layoutY="469.0" prefHeight="31.0" prefWidth="334.0" text="Row updated Succesfully" textFill="WHITE">
                           <font>
                              <Font name="System Italic" size="13.0" />
                           </font>
                        </Label>
                        <Label id="textcolor" layoutX="13.0" layoutY="65.0" prefHeight="65.0" prefWidth="134.0" stylesheets="@../styles/style.css" text="Miles">
                           <font>
                              <Font name="System Italic" size="25.0" />
                           </font>
                        </Label>
                        <Label id="textcolor" layoutX="13.0" layoutY="130.0" prefHeight="65.0" prefWidth="134.0" stylesheets="@../styles/style.css" text="Note">
                           <font>
                              <Font name="System Italic" size="25.0" />
                           </font>
                        </Label>
                        <TextField id="button2" fx:id="serviceMiles" layoutX="9.0" layoutY="115.0" prefHeight="31.0" prefWidth="319.0" />
                        <TextField id="button2" fx:id="serviceNote" layoutX="9.0" layoutY="180.0" prefHeight="31.0" prefWidth="319.0" />
                        <Label id="textcolor" fx:id="serviceSelectedCar" alignment="CENTER" layoutX="24.0" layoutY="14.0" prefHeight="41.0" prefWidth="289.0" stylesheets="@../styles/style.css" text="- Car Selected -">
                           <font>
                              <Font name="System Italic" size="25.0" />
                           </font>
                        </Label>
                        <Button id="button" fx:id="serviceBackToCars" layoutX="5.0" layoutY="507.0" mnemonicParsing="false" onAction="#goToCars" prefHeight="50.0" prefWidth="327.0" text="Back to Cars">
                           <font>
                              <Font name="System Bold" size="16.0" />
                           </font>
                        </Button>
                     </children>
                  </Pane>
               </children>
            </Pane>
         </children>
      </Pane>
      <Text id="linecolor" fill="WHITE" strokeType="OUTSIDE" strokeWidth="0.0" text="────────────────────────────────────────────────────────────────────────────────────────────────────" textAlignment="CENTER" wrappingWidth="1200.18359375" />
      <Pane prefHeight="29.0" prefWidth="1201.0">
         <children>
            <Button id="button" layoutX="491.0" layoutY="-12.0" mnemonicParsing="false" onAction="#goToHome" prefHeight="25.0" prefWidth="220.0" text="Home">
               <font>
                  <Font name="System Bold" size="15.0" />
               </font>
            </Button>
            <Button id="button" layoutX="259.0" layoutY="-12.0" mnemonicParsing="false" onAction="#goToCars" prefHeight="25.0" prefWidth="220.0" text="Cars">
               <font>
                  <Font name="System Bold" size="15.0" />
               </font>
            </Button>
            <Button id="button" layoutX="723.0" layoutY="-12.0" mnemonicParsing="false" onAction="#goToSettings" prefHeight="25.0" prefWidth="220.0" stylesheets="@../styles/style.css" text="Settings">
               <font>
                  <Font name="System Bold" size="15.0" />
               </font>
            </Button>
         </children>
      </Pane>
   </children>
</VBox>
